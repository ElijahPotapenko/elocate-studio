---
import { useTranslations, resolveLang } from '../i18n/utils';
const t = useTranslations(resolveLang(Astro.currentLocale));
const capabilities = [1, 2, 3, 4, 5, 6].map((i) => t(`about.cap.${i}`));
const stats = [1, 2, 3].map((i) => ({ v: t(`about.stat.${i}.v`), l: t(`about.stat.${i}.l`) }));
---

<section class="section about" id="about">
  <div class="container about-grid">
    <div class="about-lead">
      <p class="eyebrow">{t('about.eyebrow')}</p>
      <h2 set:html={t('about.heading')}></h2>
      <p class="about-text">{t('about.text')}</p>

      <ul class="stats">
        {stats.map((s) => (
          <li>
            <span class="stat-v">{s.v}</span>
            <span class="stat-l">{s.l}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="about-caps">
      <h3>{t('about.caps.title')}</h3>
      <ul>
        {capabilities.map((c) => <li>{c}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .about-lead h2 { font-size: var(--fs-h2); margin-top: 1rem; max-width: 22ch; }
  .accent { color: var(--accent); }
  .about-text { margin-top: 1.4rem; color: var(--muted); max-width: 52ch; font-size: var(--fs-lead); }

  .stats { list-style: none; margin: 2.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 4vw, 3.2rem); }
  .stats li { display: flex; flex-direction: column; gap: 0.3rem; }
  .stat-v { font-family: var(--font-display); font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 700; color: var(--text); }
  .stat-l { font-size: 0.85rem; color: var(--muted); }

  .about-caps {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.8rem 1.8rem 2rem;
    position: sticky; top: 96px;
  }
  .about-caps h3 { font-size: 1rem; letter-spacing: 0.04em; color: var(--muted); text-transform: uppercase; }
  .about-caps ul { list-style: none; margin: 1.1rem 0 0; padding: 0; }
  .about-caps li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.05rem;
    display: flex; align-items: center; gap: 0.7rem;
  }
  .about-caps li::before { content: '✦'; color: var(--accent); font-size: 0.75rem; }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-caps { position: static; }
  }
</style>
