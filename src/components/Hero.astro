---
import { useTranslations, resolveLang } from '../i18n/utils';
const t = useTranslations(resolveLang(Astro.currentLocale));
---

<section class="hero" id="top">
  <canvas id="bg-sphere" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="hero-title" set:html={t('hero.title')}></h1>
    <p class="hero-lead">{t('hero.lead')}</p>
    <div class="hero-actions">
      <a href="#contact" class="btn btn-primary">{t('hero.cta.primary')} <span aria-hidden="true">✦</span></a>
      <a href="#work" class="btn btn-ghost">{t('hero.cta.secondary')}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-canvas {
    /* ВРЕМЕННЫЙ ЭКСПЕРИМЕНТ (по слову Элайджи, 2026-11-20) — на весь экран и зафиксирован (не внутри
       .hero), чтобы посмотреть, как кристалл смотрится фоном на весь скролл. Было: квадрат min(62vw,760px)
       по центру hero, position:absolute — см. git history, если решение откатят. */
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    z-index: -1;
    opacity: 0.95;
  }
  .hero-grain {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(var(--grain) 1px, transparent 1px);
    background-size: 3px 3px;
  }
  /* .hero-inner делит div с .container (max-width:var(--maxw), 1240px, центрирован) — свой
     max-width здесь раньше сужал блок до 920px и центрировал его ЗАНОВО независимо от .container,
     из-за чего левый край героя (260px на 1440 вьюпорте) не совпадал с хедером/Work/About (100px).
     Узкий замер текста — на самих h1/.hero-lead (ch-юниты), не на всём контейнере. */
  /* layout по центру целиком (2026-11-19 v2, по слову Элайджи) — раньше текст был левым (тот же
     --maxw:1240px контейнер, что у хедера/Work/About — грид всё ещё совпадает, меняется только
     text-align/alignment ВНУТРИ того же контейнера, не его границы) */
  .hero-inner { padding-top: 96px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-title {
    font-size: var(--fs-display);
    margin: 1.1rem 0 0;
    /* кристалл теперь крупный и светлый ЗА текстом — тень держит контраст там, где грани светлее фона */
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.55);
  }
  .hero-title .accent {
    color: var(--accent);
    text-shadow: 0 0 38px var(--accent-glow);
  }
  .hero-lead {
    margin: 1.6rem auto 0;
    max-width: 46ch;
    font-size: var(--fs-lead);
    color: var(--text);                 /* было --muted — серый тонул в светлых гранях кристалла за ним */
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
  }
  .hero-actions { margin-top: 2.2rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; }

  @media (max-width: 620px) {
    .hero-canvas { opacity: 0.85; }
  }
</style>
