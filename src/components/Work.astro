---
import { useTranslations, resolveLang } from '../i18n/utils';
const t = useTranslations(resolveLang(Astro.currentLocale));
// Тексты (title/desc) — в i18n-словаре по ключу work.<n>.*; здесь только структура/ассеты.
// href — пока заглушка `#contact` (рабочая навигация); заменить на реальные кейс-URL/страницы.
const projects = [
  {
    n: '04',
    tags: ['Motion', '3D'],
    img: null,
    video: { src: '/assets/work/travel.mp4', poster: '/assets/work/travel-poster.jpg' },
    href: '#contact',
  },
  { n: '02', tags: ['Product', 'Data Viz'], img: '/assets/work/chat.webp', href: '#contact' },
  {
    n: '03',
    tags: ['Type', 'Motion'],
    img: null,
    video: { src: '/assets/work/identity.mp4', poster: '/assets/work/identity-poster.jpg' },
    href: '#contact',
  },
  { n: '05', tags: ['AI', 'Automation'], img: '/assets/work/support-bot.webp', posMobile: '4% 50%', href: '/demos/support-bot/' },
  { n: '06', tags: ['Product', 'Data Viz'], img: '/assets/work/analytics-pulse.webp', href: '/demos/analytics-pulse/' },
  { n: '07', tags: ['Brand', '3D'], img: '/assets/work/nova.webp', href: '/demos/nova/' },
  // imgMobile — своя обложка 16:10 для телефона (широкая 21:9 там режется по центру); posMobile — куда сдвинуть кадр, если своей нет
  { n: '08', tags: ['Gamedev', 'UI Kit'], img: '/assets/work/regnum.webp', imgMobile: '/assets/work/regnum-m.webp', href: '/demos/regnum/' },
];
---

<section class="section" id="work">
  <div class="container">
    <header class="work-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <h2 set:html={t('work.heading')}></h2>
    </header>

    <ul class="work-list">
      {projects.map((p) => (
        <li class="work-item" data-tilt>
          <a class="work-link" href={p.href}>
          <div class="work-media">
            {p.video
              ? <video
                  class="work-video"
                  src={p.video.src}
                  poster={p.video.poster}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  width="800"
                  height="600"
                  aria-label={t(`work.${p.n}.title`)}
                ></video>
              : p.img
                ? <picture>
                    {p.imgMobile && <source media="(max-width: 759px)" srcset={p.imgMobile} />}
                    <img src={p.img} alt={t(`work.${p.n}.title`)} loading="lazy" width="640" height="420" style={p.posMobile ? `--pos-m: ${p.posMobile}` : undefined} />
                  </picture>
                : <div class="work-placeholder" aria-hidden="true"><span>{p.n}</span></div>}
          </div>
          <div class="work-body">
            <h3>{t(`work.${p.n}.title`)}</h3>
            <p class="work-desc">{t(`work.${p.n}.desc`)}</p>
            <ul class="work-tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
          </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Видео-кейс: аппаратный декод (без лага), играем только когда карточка в зоне видимости
  // (батарея), уважаем reduced-motion (тогда остаётся постер). muted+playsinline → играет инлайн на мобиле.
  document.querySelectorAll('video.work-video').forEach((v) => {
    if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) return; // только постер
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting) v.play().catch(() => {});
        else v.pause();
      }, { threshold: 0.25 }).observe(v);
    } else {
      v.play().catch(() => {});
    }
  });
</script>

<style>
  .work-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .work-head h2 { font-size: var(--fs-h2); margin-top: 0.9rem; }

  .work-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;       /* мобила: одна колонка */
    gap: clamp(1.2rem, 2.5vw, 2rem);
  }

  /* БЕНТО на десктопе (6 колонок) — ритм большая/маленькие/большая/маленькие (2026-11-18):
     ряд1: [04 Travel видео ·6] — полноширинный баннер
     ряд2: [02 ·3][03 видео ·3] — две равные плитки
     ряд3: [05 Support Bot ·6] — снова полноширинный баннер (тот же вес, что у 04/07)
     ряд4: [06 ·3][07 ·3] — две равные плитки
     ряд5: [08 Regnum ·6] — широкий баннер, закрывает сетку тем же весом (2026-11-26) */
  @media (min-width: 760px) {
    .work-list { grid-template-columns: repeat(6, 1fr); }
    .work-item:nth-child(1) { grid-column: span 6; }
    /* широкий баннер — кинематографичный кроп 4:3-видео */
    .work-item:nth-child(1) .work-media { aspect-ratio: 21 / 9; }
    .work-item:nth-child(2) { grid-column: span 3; }
    .work-item:nth-child(3) { grid-column: span 3; }
    .work-item:nth-child(4) { grid-column: span 6; }
    .work-item:nth-child(4) .work-media { aspect-ratio: 21 / 9; }
    .work-item:nth-child(5) { grid-column: span 3; }
    .work-item:nth-child(6) { grid-column: span 3; }
    .work-item:nth-child(7) { grid-column: span 6; }
    .work-item:nth-child(7) .work-media { aspect-ratio: 21 / 9; }
  }
  .work-item {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.4s var(--ease), transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
    will-change: transform;
  }
  .work-item:hover {
    border-color: var(--line-2);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--accent-soft);
  }
  .work-link { display: block; color: inherit; text-decoration: none; }

  /* подпись «View case ↗» убрана (2026-11-21, по слову Элайджи) — карточка целиком ссылка, кликабельна сама */

  /* 3-я карточка (видео, тёмная) — лёгкий акцент-вес, чтобы не проваливалась в ряду */
  .work-media:has(.work-video) {
    box-shadow: inset 0 0 0 1px var(--accent-soft), inset 0 -50px 60px -45px var(--accent-soft);
  }

  .work-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-elev); }
  .work-media picture { display: contents; }
  @media (max-width: 759px) { .work-media img { object-position: var(--pos-m, 50% 50%); } }   /* широкая обложка на телефоне — не терять заголовок слева */
  .work-media img,
  .work-video {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease), filter 0.6s var(--ease);
    filter: saturate(0.9) contrast(1.02);
    display: block;
  }
  .work-item:hover .work-media img,
  .work-item:hover .work-video { transform: scale(1.05); filter: none; }
  .work-placeholder {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    background:
      radial-gradient(120% 120% at 80% 0%, var(--accent-soft), transparent 60%),
      var(--bg-elev);
  }
  .work-placeholder span {
    font-family: var(--font-display); font-size: 4rem; font-weight: 700;
    color: var(--line-2);
  }
  .work-body { padding: 1.4rem 1.5rem 1.7rem; }
  .work-body h3 { font-size: var(--fs-h3); }
  .work-desc { margin-top: 0.6rem; color: var(--muted); font-size: 0.97rem; }
  .work-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.1rem 0 0; padding: 0; }
  .work-tags li {
    font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--muted);
    padding: 0.3rem 0.65rem; border: 1px solid var(--line); border-radius: 999px;
  }
</style>
