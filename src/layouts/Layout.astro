---
import '../styles/global.css';

const {
  title = 'Elocate Studio — Design collaboration across disciplines',
  description = 'Elocate — a design studio working across disciplines: product, interface, and brand in one coherent system.',
} = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'en'}>
  <head>
    <!-- mark JS as alive early → CSS hides .reveal only then; without JS content stays visible.
         Тема ставится ДО отрисовки (из localStorage / системной) — без вспышки. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'light' && t !== 'dark') t = 'dark'; // тёмная по умолчанию (бренд), светлая — по выбору
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080c" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- прелоадер: виден ТОЛЬКО если JS подтверждённо жив (html.js, ставится в <head> до отрисовки —
         см. комментарий там же). Без JS оверлей никогда не показывается и не может навечно закрыть сайт. -->
    <div id="loader" aria-hidden="true">
      <svg class="loader-mark" viewBox="0 0 64 64" width="44" height="44">
        <circle class="loader-ring" cx="32" cy="32" r="26" fill="none" stroke-width="2.5"></circle>
        <circle class="loader-dot" cx="32" cy="32" r="5"></circle>
      </svg>
      <div class="loader-bar"><span></span></div>
      <div class="loader-pct">0%</div>
    </div>

    <!-- scroll progress indicator -->
    <div class="scroll-progress" aria-hidden="true"><span></span></div>

    <slot />

    <style is:global>
      /* — прелоадер — */
      #loader {
        display: none;                 /* показываем только при html.js, см. комментарий у разметки */
        position: fixed; inset: 0; z-index: 10000;
        flex-direction: column; align-items: center; justify-content: center; gap: 22px;
        background: var(--bg);
        transition: opacity .5s var(--ease), visibility .5s var(--ease);
      }
      html.js #loader { display: flex; }
      html.loading { overflow: hidden; }   /* не даём скроллить под оверлеем, пока он виден */
      #loader.loader-hide { opacity: 0; visibility: hidden; pointer-events: none; }
      .loader-mark { overflow: visible }
      .loader-ring {
        stroke: var(--accent);
        stroke-linecap: round;
        stroke-dasharray: 164;           /* ≈ 2π·26 */
        stroke-dashoffset: 164;
        transform-origin: 32px 32px;
        transform: rotate(-90deg);
        animation: loader-draw 1.1s var(--ease) forwards;
      }
      .loader-dot {
        fill: var(--accent);
        transform-origin: 32px 32px;
        animation: loader-pulse 1.1s ease-in-out infinite;
      }
      @keyframes loader-draw { to { stroke-dashoffset: 0; } }
      @keyframes loader-pulse {
        0%, 100% { transform: scale(.82); opacity: .7; }
        50% { transform: scale(1.14); opacity: 1; }
      }
      .loader-bar { width: 120px; height: 2px; background: var(--line-2); border-radius: 2px; overflow: hidden; }
      .loader-bar span {
        display: block; height: 100%; width: 0%;
        background: var(--accent); box-shadow: 0 0 10px var(--accent-glow);
        transition: width .3s var(--ease);
      }
      .loader-pct {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
        letter-spacing: .02em;
      }
      @media (prefers-reduced-motion: reduce) {
        .loader-ring { animation: none; stroke-dashoffset: 0; }
        .loader-dot { animation: none; }
      }

      /* — кастомный курсор: простая белая точка — */
      .has-custom-cursor,
      .has-custom-cursor a,
      .has-custom-cursor button,
      .has-custom-cursor input,
      .has-custom-cursor textarea,
      .has-custom-cursor [role='button'] { cursor: none; }

      .cursor-dot {
        position: fixed;
        top: 0; left: 0;
        width: 10px; height: 10px;
        margin: -5px 0 0 -5px;            /* центрируем относительно translate3d */
        border-radius: 50%;
        background: var(--cursor);
        pointer-events: none;
        z-index: 9999;
        /* НЕ анимируем transform → точка идёт за мышью без лага.
           Плавность только у размера/прозрачности. */
        transition: width 0.18s var(--ease), height 0.18s var(--ease), margin 0.18s var(--ease), opacity 0.2s, background 0.4s var(--ease);
      }
      .cursor-hover .cursor-dot {
        width: 20px; height: 20px; margin: -10px 0 0 -10px;
        opacity: 0.85;
      }
      .cursor-hidden .cursor-dot { opacity: 0; }

      /* — индикатор скролла — */
      .scroll-progress {
        position: fixed; top: 0; left: 0; right: 0;
        height: 2px; z-index: 9998; background: transparent; pointer-events: none;
      }
      .scroll-progress span {
        display: block; height: 100%; width: var(--p, 0%);
        background: linear-gradient(90deg, transparent, var(--accent));
        box-shadow: 0 0 12px var(--accent-glow);
      }
    </style>

    <script>
      import { initCursor } from '../scripts/cursor.js';
      import { initReveal } from '../scripts/reveal.js';
      import { initTilt } from '../scripts/tilt.js';
      import { initLoader } from '../scripts/loader.js';

      initLoader();

      const start = () => {
        // three.js/crystal.js — 492Кб, отдельный динамический чанк: без статического импорта
        // браузер ждал ВЕСЬ этот граф модулей ДО выполнения даже initLoader() — на медленном
        // проде именно это читалось как «долго грузится», не сам рендер страницы.
        import('../scripts/crystal.js').then(({ initCrystal }) => initCrystal());
        initCursor();
        initReveal();
        initTilt();

        // прогресс скролла
        const bar = document.querySelector('.scroll-progress span');
        const onScroll = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? (h.scrollTop / max) * 100 : 0;
          bar?.style.setProperty('--p', p + '%');
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      };

      if (document.readyState !== 'loading') start();
      else document.addEventListener('DOMContentLoaded', start);
    </script>
  </body>
</html>
